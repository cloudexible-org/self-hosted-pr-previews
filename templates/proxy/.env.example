# Copy to .env next to compose.yaml on the preview host. Never commit .env.

# certificates.acme_email — Let's Encrypt expiry and problem notices.
ACME_EMAIL=

# Cloudflare API token with Zone → Zone → Read and Zone → DNS → Edit on
# certificates.challenge_delegation_zone ONLY. Project zones are never granted.
CF_DNS_API_TOKEN=

# dashboard.host — the preview host's own tailnet name.
DASHBOARD_HOST=preview-host.your-tailnet.ts.net
